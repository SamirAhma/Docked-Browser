# Template only — do not hardcode a username or home path here.
# Prefer: ./bin/install-autostart
[Desktop Entry]
Type=Application
Version=1.0
Name=Docked Browser
Comment=Start Docked Browser tray + UI on login
Exec=REPLACE_WITH_REPO/bin/docked-tray
Path=REPLACE_WITH_REPO
Terminal=false
X-GNOME-Autostart-enabled=true
StartupNotify=false
Categories=Network;Utility;
