#!/usr/bin/env bash
# Start the scheduler or dispatch its per-poll worker.
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
rust="$root/gui-server/target/release/docked-browser-gui"
export DOCKER_CONTEXT=default

if [[ "${1:-}" != --poll-worker && -x "$rust" && -z "${DOCKED_BROWSER_PYTHON_GUI:-}" ]]; then
  export DOCKED_BROWSER_ROOT="$root"
  exec "$rust" predict-daemon
fi
exec python3 "$root/gui/predict_sleep_worker.py" "$@"
