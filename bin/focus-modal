#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
rust="$root/gui-server/target/release/docked-browser-gui"
export DOCKER_CONTEXT=default
if [[ -x "$rust" && -z "${DOCKED_BROWSER_PYTHON_GUI:-}" ]]; then
  export DOCKED_BROWSER_ROOT="$root"
  exec "$rust" focus-modal
fi
exec python3 "$root/gui/focus_modal_fallback.py" "$@"
