#!/usr/bin/env python3
"""Docked Browser focus modal — quick picker for open Chromes."""
from __future__ import annotations

import os
import sys
import threading

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk, Pango

GUI_DIR = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "gui")
sys.path.insert(0, GUI_DIR)
from control import (  # noqa: E402
    get_theme,
    list_playing_profiles,
    modal_window_icon,
    open_full_gui,
    profile_icon_path,
    run_cli,
)

APP_ID = "org.dockedbrowser.focus"

# Paint both themes ourselves on top of Adwaita (light). Never enable
# Adwaita:dark — its button gradients fight label colors (white-on-white).
