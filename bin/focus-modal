_css_provider: Gtk.CssProvider | None = None


def _apply_theme(theme: str | None = None) -> None:
    global _css_provider
    theme = theme or get_theme()
    os.environ["GTK_THEME"] = "Adwaita"
    settings = Gtk.Settings.get_default()
    if settings is not None:
        settings.set_property("gtk-application-prefer-dark-theme", False)
        try:
            settings.set_property("gtk-theme-name", "Adwaita")
        except Exception:
            pass

    screen = Gdk.Screen.get_default()
    if screen is None:
        return
    if _css_provider is not None:
        Gtk.StyleContext.remove_provider_for_screen(screen, _css_provider)
    _css_provider = Gtk.CssProvider()
    _css_provider.load_from_data(CSS_DARK if theme == "dark" else CSS_LIGHT)
    Gtk.StyleContext.add_provider_for_screen(
        screen,
        _css_provider,
        Gtk.STYLE_PROVIDER_PRIORITY_USER,
    )


def _state_color(state: str) -> str:
    dark = get_theme() == "dark"
    if state == "running":
        return "#30d158" if dark else "#34c759"
    if state == "paused":
        return "#ff9f0a" if dark else "#ff9500"
    return "#636366" if dark else "#c7c7cc"


def _load_pixbuf(path: str, size: int = 36):
    from gi.repository import GdkPixbuf

    return GdkPixbuf.Pixbuf.new_from_file_at_scale(path, size, size, True)


def _state_label(state: str) -> str:
    return {"running": "Open", "paused": "Paused", "stopped": "Closed"}.get(
        state, state.title() if state else ""
    )


class FocusWindow(Gtk.ApplicationWindow):
    def __init__(self, app: Gtk.Application) -> None:
        super().__init__(application=app, title="Docked Browser")
        self.set_default_size(380, 440)
        self.set_keep_above(True)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self._apply_window_icon()

        bar = Gtk.HeaderBar()
        bar.set_show_close_button(True)
        bar.set_title("Docked Browser")
        bar.get_style_context().add_class("titlebar")
        self.set_titlebar(bar)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        outer.set_margin_top(16)
        outer.set_margin_bottom(16)
        outer.set_margin_start(16)
        outer.set_margin_end(16)
        self.add(outer)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        title = Gtk.Label(label="Open now")
        title.get_style_context().add_class("section-title")
        title.set_halign(Gtk.Align.START)
        title.set_hexpand(True)
        header.pack_start(title, True, True, 0)

        refresh_btn = Gtk.Button.new_with_label("Refresh")
        refresh_btn.connect("clicked", lambda *_: self.reload())
        header.pack_end(refresh_btn, False, False, 0)
        outer.pack_start(header, False, False, 0)

        hint = Gtk.Label(label="Click to focus · Right-click to Pause or Close")
        hint.set_halign(Gtk.Align.START)
        hint.set_line_wrap(True)
        hint.get_style_context().add_class("hint")
        outer.pack_start(hint, False, False, 0)

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scrolled.set_vexpand(True)
        scrolled.set_shadow_type(Gtk.ShadowType.NONE)
        outer.pack_start(scrolled, True, True, 0)

        self.list_box = Gtk.ListBox()
        self.list_box.set_selection_mode(Gtk.SelectionMode.NONE)
        self.list_box.set_activate_on_single_click(True)
        self.list_box.connect("row-activated", self.on_row_activated)
        scrolled.add(self.list_box)

        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        footer.set_margin_top(4)
        ui_btn = Gtk.Button.new_with_label("Open Web UI")
        ui_btn.get_style_context().add_class("suggested-action")
        ui_btn.connect("clicked", lambda *_: open_full_gui())
        footer.pack_start(ui_btn, False, False, 0)

        close_btn = Gtk.Button.new_with_label("Done")
        close_btn.connect("clicked", lambda *_: self.close())
        footer.pack_end(close_btn, False, False, 0)
        outer.pack_start(footer, False, False, 0)

        self._busy = False
        self._theme = get_theme()
        self.reload()
        GLib.timeout_add_seconds(3, self._tick)

    def _apply_window_icon(self) -> None:
        path = modal_window_icon()
        if path.is_file():
            try:
                self.set_icon(_load_pixbuf(str(path), 64))
            except Exception:
                pass

    def _tick(self) -> bool:
        # Re-resolve theme (system may follow the desktop)
        theme = get_theme()
        if theme != getattr(self, "_theme", None):
            self._theme = theme
            _apply_theme(theme)
        if not self._busy:
            self.reload()
        return True

    def reload(self) -> None:
        self._apply_window_icon()
        for child in list(self.list_box.get_children()):
            self.list_box.remove(child)

        items = list_playing_profiles()
        if not items:
            self.list_box.add(self._empty_row())
        else:
            for item in items:
                self.list_box.add(self._make_row(item))
        self.list_box.show_all()

    def _empty_row(self) -> Gtk.ListBoxRow:
        row = Gtk.ListBoxRow()
        row.get_style_context().add_class("empty-row")
        row.set_selectable(False)
        row.set_activatable(False)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_margin_top(48)
        box.set_margin_bottom(48)
        box.set_halign(Gtk.Align.CENTER)

        title = Gtk.Label(label="Nothing open")
        title.get_style_context().add_class("empty-title")
        box.pack_start(title, False, False, 0)

        body = Gtk.Label(label="Open a browser from the dock\nor the Web UI.")
        body.set_justify(Gtk.Justification.CENTER)
        body.set_line_wrap(True)
        body.get_style_context().add_class("empty-body")
        box.pack_start(body, False, False, 0)

        row.add(box)
        return row

    def _make_row(self, item: dict) -> Gtk.ListBoxRow:
        row = Gtk.ListBoxRow()
        row.profile = item["profile"]
        row.state = item["state"]

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        box.set_margin_top(10)
        box.set_margin_bottom(10)
        box.set_margin_start(8)
        box.set_margin_end(8)

        icon_path = item.get("icon") or ""
        if not icon_path:
            p = profile_icon_path(item["profile"])
            icon_path = str(p) if p else ""
        if icon_path and os.path.isfile(icon_path):
            try:
                img = Gtk.Image.new_from_pixbuf(_load_pixbuf(icon_path, 36))
            except Exception:
                img = Gtk.Image.new_from_icon_name("web-browser", Gtk.IconSize.DND)
        else:
            img = Gtk.Image.new_from_icon_name("web-browser", Gtk.IconSize.DND)
        box.pack_start(img, False, False, 0)

        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        name = Gtk.Label()
        name.set_halign(Gtk.Align.START)
        name.set_ellipsize(Pango.EllipsizeMode.END)
        name.get_style_context().add_class("profile-name")
        escaped = GLib.markup_escape_text(item["profile"])
        if item.get("active"):
            name.set_markup(f"<b>{escaped}</b>")
        else:
            name.set_text(item["profile"])
        text.pack_start(name, False, False, 0)

        bits = [_state_label(item["state"])]
        if item.get("active"):
            bits.append("Front")
        state_label = Gtk.Label(label=" · ".join(bits))
        state_label.set_halign(Gtk.Align.START)
        state_label.get_style_context().add_class("profile-state")
        text.pack_start(state_label, False, False, 0)
        box.pack_start(text, True, True, 0)

        dot = Gtk.Label()
        color = _state_color(item["state"])
        dot.set_markup(f'<span foreground="{color}" size="x-large">●</span>')
        box.pack_end(dot, False, False, 0)

        row.add(box)
        row.connect("button-press-event", self.on_row_button)
        return row

    def on_row_button(self, row: Gtk.ListBoxRow, event: Gdk.EventButton) -> bool:
        if event.button == 3:
            self._popup_menu(row, event)
            return True
        return False

    def _popup_menu(self, row: Gtk.ListBoxRow, event: Gdk.EventButton) -> None:
        menu = Gtk.Menu()
        profile = row.profile

        def add(label: str, action: str) -> None:
            item = Gtk.MenuItem.new_with_label(label)
            item.connect("activate", lambda *_: self._run_action(action, profile))
            menu.append(item)

        add("Focus", "activate")
        add("Pause", "pause")
        add("Close", "stop")
        menu.show_all()
        menu.popup_at_pointer(event)

    def on_row_activated(self, _list: Gtk.ListBox, row: Gtk.ListBoxRow) -> None:
        if not hasattr(row, "profile"):
            return
        self._run_action("activate", row.profile)

    def _run_action(self, action: str, profile: str) -> None:
        if self._busy:
            return
        self._busy = True
        win = self.get_window()
        if win is not None:
            win.set_cursor(Gdk.Cursor.new_from_name(self.get_display(), "wait"))

        def work() -> None:
            result = run_cli(action, profile)

            def done() -> None:
                self._busy = False
                if win is not None:
                    win.set_cursor(None)
                self.reload()
                if not result["ok"] and action != "activate":
                    dlg = Gtk.MessageDialog(
                        transient_for=self,
                        flags=0,
                        message_type=Gtk.MessageType.WARNING,
                        buttons=Gtk.ButtonsType.OK,
                        text=result["output"][:500] or "Action failed",
                    )
                    dlg.run()
                    dlg.destroy()

            GLib.idle_add(done)

        threading.Thread(target=work, daemon=True).start()


class FocusApp(Gtk.Application):
    def __init__(self) -> None:
        super().__init__(application_id=APP_ID)
        self._window: FocusWindow | None = None

    def do_activate(self) -> None:
        if self._window is None:
            self._window = FocusWindow(self)
            self._window.show_all()
        else:
            self._window.present()


def main() -> int:
    os.environ.setdefault("DISPLAY", ":0")
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    os.environ.setdefault("XDG_RUNTIME_DIR", runtime)
    if not os.environ.get("WAYLAND_DISPLAY"):
        sock = os.path.join(runtime, "wayland-0")
        if os.path.exists(sock):
            os.environ["WAYLAND_DISPLAY"] = "wayland-0"
    _apply_theme()
    return FocusApp().run(sys.argv)


if __name__ == "__main__":
    raise SystemExit(main())
