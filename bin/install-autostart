#!/usr/bin/env bash
# Write ~/.config/autostart entries for this checkout.
# Paths are resolved on the local machine and are NOT stored in the repo.
set -euo pipefail

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$BIN_DIR/.." && pwd)"
DEST_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"

mkdir -p "$DEST_DIR"
# Remove legacy autostart names
rm -f "$DEST_DIR/chrome-cockpit.desktop"

# Keep optional web UI on login
cat > "$DEST_DIR/docked-browser.desktop" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Docked Browser UI
Comment=Start Docked Browser web UI on login
Exec=$BIN_DIR/start-gui
Path=$ROOT_DIR
Terminal=false
X-GNOME-Autostart-enabled=true
StartupNotify=false
Categories=Network;Utility;
EOF

# Tray indicator (focus surface)
cat > "$DEST_DIR/docked-browser-tray.desktop" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=Docked Browser Tray
Comment=Tray indicator + focus modal for Docked Browser
Exec=$BIN_DIR/docked-tray
Path=$ROOT_DIR
Terminal=false
X-GNOME-Autostart-enabled=true
StartupNotify=false
Categories=Network;Utility;
EOF

# Ensure profile dock entries exist
"$BIN_DIR/docked-browser" refresh-dock >/dev/null || true

echo "Installed autostart → $DEST_DIR/docked-browser.desktop"
echo "Installed autostart → $DEST_DIR/docked-browser-tray.desktop"
echo "Tip: ./bin/install-hotkey   # Super+Shift+D opens the focus modal"
echo "Pin profile icons from the app grid (Docked · <name>)."
